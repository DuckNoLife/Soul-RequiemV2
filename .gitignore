# =====================================================================
# Soul Requiem - .gitignore
# Part 1: official Unity template (github/gitignore, CC0-1.0)
# Part 2: project-specific rules
# =====================================================================

# ---------------------------------------------------------------------
# Part 1 - Unity template
# ---------------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Memory captures and recordings (large, may hold sensitive data)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio / Gradle caches
.vs/
.gradle/

# Autogenerated solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and Mono
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# Test Runner and Addressables
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ---------------------------------------------------------------------
# Part 2 - Soul Requiem
# ---------------------------------------------------------------------

# Editor settings (personal)
.vscode/

# Binary art, audio, fonts and models are not stored in Git:
# the Git LFS quota is exhausted and the asset-pack licences
# do not allow redistribution. The playable build is delivered separately.
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tga
*.tif
*.tiff
*.webp
*.psd
*.exr
*.hdr
*.cubemap
*.wav
*.mp3
*.ogg
*.aif
*.aiff
*.mp4
*.mov
*.avi
*.ttf
*.otf
*.fbx
*.FBX
*.blend
*.3ds
*.max

# Archives and executables
*.zip
*.7z
*.rar
*.tar
*.gz
*.tgz
*.exe

# Documents: only the root README is published
*.md
*.md.meta
!/README.md
*.pdf
*.docx

# Secrets
.env
.env.local

# Local working folders
/_tools/
/_backups/
/_to_delete/
/_lfsfix/
/Claude outputs/
__pycache__/
*.pyc

__MACOSX/
__MACOSX.meta
._*
.DS_Store
/_tools/
